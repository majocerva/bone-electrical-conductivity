// =========================================================
// CREAR VOLUMENES
// =========================================================
ThruSections(1) = {101, 201, 301}; // volumen externo
ThruSections(2) = {102, 202, 302}; // externo trabecular
ThruSections(3) = {402, 502, 602}; // externo medular

// cortical = externo - trabecular
cortical() = BooleanDifference{ Volume{1}; Delete; }{ Volume{2}; };

// trabecular = trabecular externa - medula
trabecular() = BooleanDifference{ Volume{2}; Delete; }{ Volume{3}; };

// medular = volumen interno
medular() = {3};

// =========================================================
// LIMPIAR ENTIDADES AUXILIARES
// =========================================================
Delete {
  Surface{:};
  Curve{:};
  Point{:};
}

Coherence;

// =========================================================
// ROTAR PARA ALINEAR EJE CON Z
// =========================================================
Rotate {{0, 1, 0}, {0, 0, 0}, -0.244979} {
  Volume{:};
}


// Electrodo 1
Cylinder(500) = {-5.370989745192989, -8.9276164633918, 70.11576650491325, -7.736257044989828, -18.442155499811694, -0.1929441748554278, 5};

