// =========================================================
// OPERACIONES BOOLEANAS
// =========================================================
frag() = BooleanFragments{
  Volume{cortical(0)};
  Volume{trabecular(0)};
  Volume{medular(0)};
  Delete;
}{
  Volume{500};
  Volume{501};
  Volume{502};
  Volume{503};
  Delete;
};

Coherence;

